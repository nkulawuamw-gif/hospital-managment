# Django
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for local; set DATABASE_URL for production)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=hms_db
DB_USER=hms_user
DB_PASSWORD=hms_password
DB_HOST=localhost
DB_PORT=5432

# For Render/PostgreSQL — set this env var to override all DB_* above
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
DISABLE_REDIS=True
DISABLE_CELERY=True

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=HMS <noreply@hospital.com>

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# JWT
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# Site
SITE_NAME=HMS Hospital
SITE_URL=http://localhost:8000

# Render (set automatically by Render)
RENDER_EXTERNAL_HOSTNAME=
